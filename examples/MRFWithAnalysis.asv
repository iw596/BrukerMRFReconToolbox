T1MRFROI5Std = std(T1MRFROI5,1,"all");
T1RefROI5 = mean(T1RefMap(ROI5Row,ROI5Col),'all');


ROI6Row = [98:108];
ROI6Col = [71:81];
T1MRFROI6 = T1Map(ROI6Row,ROI6Col);
T1MRFROI6Mean = mean(T1Map(ROI6Row,ROI6Col),'all');
T1MRFROI6Std = std(T1MRFROI6,1,"all");
T1RefROI6 = mean(T1RefMap(ROI6Row,ROI6Col),'all');

ROI7Row = [81:92];
ROI7Col = [92:102];
RefROI7Row = [52:62];
RefROI7Col = [9:106];
T1MRFROI7 = T1Map(ROI7Row,ROI7Col);
T1MRFROI7Mean = mean(T1Map(ROI7Row,ROI7Col),'all');
T1MRFROI7Std = std(T1MRFROI7,1,"all");
T1RefROI7 = mean(T1RefMap(ROI7Row,ROI7Col),'all');

MRFROI8Row = [52:62];
MRFROI8Col = [100:110];
RefROI8Row = [52:62];
RefROI8Col = [94:106];
T1MRFROI8 = T1Map(ROI8Row,ROI8Col);
T1MRFROI8Mean = mean(T1Map(ROI8Row,ROI8Col),'all');
T1MRFROI8Std = std(T1MRFROI8,1,"all");
T1RefROI8 = mean(T1RefMap(RefROI8Row,RefROI8Col),'all');




MRFT1MeanRes = [T1MRFROI1Mean,T1MRFROI2Mean,T1MRFROI3Mean,T1MRFROI4Mean,T1MRFROI5Mean,T1MRFROI6Mean,T1MRFROI7Mean,T1MRFROI8Mean];
RefT1MeanRes = [T1RefROI1,T1RefROI2,T1RefROI3,T1RefROI4,T1RefROI5,T1RefROI6,T1RefROI7,T1RefROI8];
SD = [T1MRFROI1Std,T1MRFROI2Std,T1MRFROI3Std,T1MRFROI4Std,T1MRFROI5Std,T1MRFROI6Std,T1MRFROI7Std,T1MRFROI8Std];
% Fit a polynomial p of degree 1 to the data:
degree = 1;
p = polyfit(RefT1MeanRes,MRFT1MeanRes,degree);

% Evaluate the fitted polynomial p and plot:
f = polyval(p,RefT1MeanRes);
eqn = poly_equation(p); % polynomial equation (string)
Rsquared = my_Rsquared_coeff(MRFT1MeanRes,f); % correlation coefficient




figure(3);
plot(RefT1MeanRes,MRFT1MeanRes,'x',RefT1MeanRes,f,'--',LineWidth=2)
hold on;
% Add error bars for standard deviation
errorbar(RefT1MeanRes, MRFT1MeanRes, SD, 'LineStyle', 'none', 'Color', 'k', 'CapSize', 10);
plot(RefT1MeanRes,MRFT1MeanRes,'x',RefT1MeanRes,f,'--',LineWidth=2)
legend('data',eqn)
xlabel("T1 ground truth [ms]","Fontsize",20);
ylabel("T1 MRF [ms]","Fontsize",20)
axis = gca;
axis.FontSize = 20;
title(['Data fit - R squared = ' num2str(Rsquared)]);




