addpath("Simulations\")
addpath("recon\")
addpath("B1Mapping\")
addpath("Fitting\")
addpath("FileIO\")
addpath("MRF\")


%% First we need to generate our look-up table of T1 and T2 values
T1Range = [100:100:1000];
T2Range = [10:10:100];

% Exclude T2 > T1
NDictionaryEntries = 0 ;
% Prepare look-up table containing all valid pairs
LUT = [];
for ii = 1:length(T1Range)
    for jj = 1:length(T2Range)
        % Only keep physically feasible pairs (i.e. T1 > T2)
        if (T1Range(ii)>=T2Range(jj))
            LUT(NDictionaryEntries+1,[1:2]) = [T1Range(ii),T2Range(jj)];
            NDictionaryEntries = NDictionaryEntries + 1;
        end
    end
end

% Read FA train
[FA,~] = ReadMRFList("datasets\MRFLowFA\MRFPattern.txt");
% Read preplist and preptimes
prepList = ReadMRFPrepList("datasets\MRFLowFA\PrepList.txt");
% Read method file
params = LoadBrukerData("datasets\MRFLowFA\42");


NSpin = 200;
phi = linspace(-pi,pi,NSpin);
dict = zeros(length(prepList) * length(FA),length(LUT));
TR = params.TR * 1000;
TE = 4;

for i = 1:size(LUT,1)
    T1Tmp = LUT(i,1);
    T2Tmp = LUT(i,2);
    % Set-up starting magnetization
    M = zeros([3,NSpin]);
    M(3,:) = 1;
    curEntry = 1;
    % Run through prep modules
    for p = 1:size(prepList,1)
        if (prepList(p,1) == 0)
            M = SimulateInversion(M,T1Tmp,T2Tmp,prepList(p,2));
        elseif (prepList(p,1) == 1)
            M = SimulateT2Prep(M,prepList(p,2),NSpin,2,T1Tmp,T2Tmp);
        end
        % Run through the FA train
        for f = 1:length(FA)
            R = throt(FA(f),0);
            M = R*M;
            % Precess to TE
            [A,B] = freeprecess(TE,T1Tmp,T2Tmp);
            M = A*M + B;
            % Store signal 
            dict(curEntry,i) = mean(complex(M(1,:),M(2,:)));
            % Precess until next TR
            [A,B] = freeprecess(TR - TE,T1Tmp,T2Tmp);
            M = A*M + B;

            % Apply spoiling as rotation in z direction
            for j = 1:NSpin
                M(:,j) = zrot(phi(j)) * M(:,j);
            end
            
            curEntry = curEntry + 1;
        end
        % Wait for 100ms
        [A,B] = freeprecess(100,T1Tmp,T2Tmp);
        M = A*M + B;
    end
end