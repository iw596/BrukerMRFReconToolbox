
%% Function t
function FAList = ReadFAList(pth)
    fileID = fopen(pth,'r');
    % Read first line
    tline = fgetl(fileID);
    newStr = extractAfter(tline,'#');
    NFA = str2num(newStr);
    FAList = zeros(NFA,1);
    counter = 1;
    while ischar(tline)
        tline = fgetl(fileID);
        FAList(counter) = str2double(tline);
        counter = counter + 1;
    end
    fclose(fileID);
end

