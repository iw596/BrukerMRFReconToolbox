%% Function to generate (using Bloch simulation) an MRF dictionary. The LUT defines the T1, T2 and optionally B1 range
%% used for generating the dictionary
function [dict,LUT] = GenerateDictionary(LUT,FAList,MRFBlocks,options)
arguments
    LUT 
    FAList
    MRFBlocks 
    options.ParallelProcessing = true
    options.ModelPreparationModules = false
    options.ModelSliceProfile = false;
    options.InversionModuleProperties = [];
    options.ExcitationModuleProperties =[];

end

    
if(size(LUT,1) < 2) 
    error("The LUT must have at least two columns (T1 and T2");
end

NEntries = size(LUT,2);

T1 = LUT(1,:);
T2 = LUT(2,:);

if (size(LUT,1) == 3)
    B1 = LUT(3,:);
else
    B1 = ones([NEntries,1]);
end



if (options.ParallelProcessing == false)
    for i = 1:size(LUT,2)
        T1Tmp = T1(i);
        T2Tmp = T2(i);
        B1Tmp = B1(i);
    end
else
    parfor i = 1:NEntries
    end
end



    

end

